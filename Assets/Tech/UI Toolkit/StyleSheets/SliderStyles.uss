:root {
}

#CustomizationSlider .unity-base-slider__dragger {
    background-color: rgb(255, 168, 0);
    width: 24px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    scale: 2 2 2;
    border-left-color: rgb(255, 145, 0);
    border-right-color: rgb(255, 145, 0);
    border-top-color: rgb(255, 145, 0);
    border-bottom-color: rgb(255, 145, 0);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    transition-duration: 0.1s;
}

#CustomizationSlider .unity-base-slider__dragger:hover {
    transition-duration: 0.1s;
    scale: 2.4 2.4 2.4;
    border-left-color: rgb(221, 199, 153);
    border-right-color: rgb(221, 199, 153);
    border-top-color: rgb(221, 199, 153);
    border-bottom-color: rgb(221, 199, 153);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    background-color: rgb(253, 242, 211);
}

#CustomizationSlider .unity-base-slider__dragger:focus {
    transition-duration: 0.1s;
    scale: 2.4 2.4 2.4;
    border-left-color: rgb(221, 199, 153);
    border-right-color: rgb(221, 199, 153);
    border-top-color: rgb(221, 199, 153);
    border-bottom-color: rgb(221, 199, 153);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    background-color: rgb(253, 242, 211);
}

#CustomizationSlider .unity-base-slider__dragger:active {
    transition-duration: 0.1s;
    scale: 2.2 2.2 2.4;
    border-left-color: rgb(221, 199, 153);
    border-right-color: rgb(221, 199, 153);
    border-top-color: rgb(221, 199, 153);
    border-bottom-color: rgb(221, 199, 153);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    background-color: rgb(253, 242, 211);
}

#CustomizationSlider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.392);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    scale: 1 3;
}

#SettingsSlider .unity-base-slider__dragger {
    background-color: rgb(255, 168, 0);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    scale: 1 1;
    border-left-color: rgb(255, 122, 0);
    border-right-color: rgb(255, 122, 0);
    border-top-color: rgb(255, 122, 0);
    border-bottom-color: rgb(255, 122, 0);
    width: 24px;
    margin-top: -7px;
}

#SettingsSlider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.392);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    scale: 1 2;
    padding-top: 0;
    margin-top: 2px;
}



#SettingsSlider .unity-base-slider__label {
    font-size: 25px;
    color: rgba(206, 229, 161, 0.545);
    -unity-text-outline-width: 1px;
    -unity-font-style: normal;
    -unity-text-outline-color: rgba(0, 0, 0, 0.588);
    -unity-font-definition: resource("Art/UI/Fonts/Super Starfish");
}
