:root {
}

.menuButton {
    border-left-color: rgb(193, 103, 103);
    border-right-color: rgb(193, 103, 103);
    border-top-color: rgb(204, 106, 106);
    border-bottom-color: rgb(185, 100, 100);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    background-color: rgb(248, 188, 137);
    -unity-text-outline-width: 2px;
    font-size: 40px;
    -unity-font-style: normal;
    -unity-text-outline-color: rgb(135, 103, 193);
    -unity-text-align: upper-center;
    margin-bottom: 10px;
    margin-top: 10px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
    color: rgb(135, 103, 193);
}

.menuButton:hover {
    scale: 1.1 1.1 1.1;
    background-color: rgb(250, 221, 100);
    border-left-color: rgb(246, 194, 87);
    border-right-color: rgb(245, 194, 87);
    border-top-color: rgb(250, 198, 89);
    border-bottom-color: rgb(238, 190, 89);
    color: rgb(214, 126, 52);
    -unity-text-outline-color: rgb(215, 126, 52);
}

.menuButton:active {
    border-left-color: rgb(68, 161, 136);
    border-right-color: rgb(68, 162, 137);
    border-top-color: rgb(68, 166, 138);
    border-bottom-color: rgb(61, 156, 130);
    background-color: rgb(171, 236, 155);
    scale: 1.05 1.05 1.05;
    color: rgb(40, 166, 96);
    -unity-text-outline-color: rgb(40, 166, 96);
}

.levelSelectButton {
    -unity-font-style: bold;
    font-size: 100px;
    background-color: rgba(28, 35, 60, 0.392);
    color: rgb(226, 229, 241);
    width: 12%;
}

.levelSelectButton:hover {
    -unity-font-style: bold;
    font-size: 100px;
    background-color: rgba(226, 229, 241, 0.392);
    color: rgb(28, 35, 60);
}

.levelSelectButton:active {
    -unity-font-style: bold;
    font-size: 100px;
    background-color: rgba(157, 214, 150, 0.392);
    color: rgb(214, 238, 212);
}

.choiceButton {
    width: 300px;
    height: 70px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    background-color: rgb(0, 0, 0);
    -unity-font-style: normal;
    font-size: 30px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
}

.choiceButton:hover {
    width: 300px;
    height: 70px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(255, 255, 255);
    -unity-font-style: normal;
    font-size: 30px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
}

.choiceButton:active {
    width: 300px;
    height: 70px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(219, 255, 136);
    border-right-color: rgb(219, 255, 136);
    border-top-color: rgb(219, 255, 136);
    border-bottom-color: rgb(219, 255, 136);
    background-color: rgb(219, 255, 136);
    -unity-font-style: normal;
    font-size: 30px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(78, 101, 35);
    color: rgb(78, 101, 35);
}

.textMenu {
    color: rgb(57, 82, 42);
    -unity-text-outline-color: rgb(57, 82, 42);
    -unity-text-outline-width: 4px;
    font-size: 28px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
}

.PAUSE_MENU {
    background-color: rgba(0, 0, 0, 0.784);
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.customizeText {
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 4px;
    -unity-text-align: upper-center;
    font-size: 40px;
    -unity-font-definition: url("project://database/Packages/com.unity.collab-proxy/Editor/Assets/Fonts/Cascadia.ttf?fileID=12800000&guid=9229ae5dbc38f488d921156ff75869e9&type=3#Cascadia");
}

.customizationButton {
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
