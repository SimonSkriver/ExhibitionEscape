<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="slot" class="invSlot" style="flex-grow: 1; justify-content: center; background-color: rgb(123, 123, 123); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(67, 67, 67); border-right-color: rgb(67, 67, 67); border-top-color: rgb(67, 67, 67); border-bottom-color: rgb(67, 67, 67); position: absolute; height: 100%; width: 100%; bottom: 0;">
        <ui:Image name="item_icon" source="project://database/Resources/unity_builtin_extra?fileID=10906&amp;guid=0000000000000000f000000000000000&amp;type=0#Background" class="itemIMG" style="height: 80%; padding-top: 10px;"/>
        <ui:Label text="item" name="item_name" class="itemName" style="height: 20%; -unity-text-align: upper-center; -unity-font-style: italic; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; letter-spacing: 7px; -unity-text-auto-size: none; -unity-text-generator: standard;"/>
    </ui:VisualElement>
    <ui:Label text="-" name="item_count" class="itemCount" style="position: absolute; top: -35px; right: -15px; -unity-font-style: bold; font-size: 50px; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255);"/>
</ui:UXML>
