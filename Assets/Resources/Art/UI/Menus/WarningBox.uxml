<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tech/UI%20Toolkit/StyleSheets/MenuStyle.uss?fileID=7433441132597879392&amp;guid=42a1f58cb3150cd4ab49c63b8acaf772&amp;type=3#MenuStyle"/>
    <ui:VisualElement class="menuButton" style="flex-grow: 1; width: 800px; justify-content: space-between; align-self: center; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
        <ui:Label text="WARNING!" style="color: rgb(204, 106, 106); -unity-text-outline-color: rgb(204, 106, 106); font-size: 70px;"/>
        <ui:Label text="If you leave the island&#10;you will lose you progress!&#10;&#10;Do you want to continue?" style="font-size: 30px; color: rgb(204, 106, 106); -unity-text-outline-color: rgb(204, 106, 106);"/>
        <ui:GroupBox style="flex-direction: row; justify-content: space-around; align-self: stretch; align-items: center;">
            <ui:Button text="Yes" name="YES" class="menuButton" style="background-color: rgb(193, 103, 103); color: rgb(0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0);">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:0e0ba97df2b1b9a438f0e8abd1ec2cd9" entry="Id(1166099980664832)">
                        <variables>
                            <UnityEngine.Localization.LocalVariable name="isLeavingButton">
                                <UnityEngine.Localization.SmartFormat.PersistentVariables.BoolVariable value="true"/>
                            </UnityEngine.Localization.LocalVariable>
                        </variables>
                    </UnityEngine.Localization.LocalizedString>
                </Bindings>
            </ui:Button>
            <ui:Button text="Noooooooooooo" name="NO" class="menuButton" style="background-color: rgb(193, 103, 103); -unity-text-outline-color: rgb(255, 255, 255); color: rgb(255, 255, 255);">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:0e0ba97df2b1b9a438f0e8abd1ec2cd9" entry="Id(1166099980664832)">
                        <variables>
                            <UnityEngine.Localization.LocalVariable name="isLeavingButton">
                                <UnityEngine.Localization.SmartFormat.PersistentVariables.BoolVariable value="false"/>
                            </UnityEngine.Localization.LocalVariable>
                        </variables>
                    </UnityEngine.Localization.LocalizedString>
                </Bindings>
            </ui:Button>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
