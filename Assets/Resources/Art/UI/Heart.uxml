<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement name="HeartOutline" style="flex-grow: 1; background-image: resource(&quot;Art/Textures/UI_textures/Heart&quot;); background-size: 256px 256px; -unity-background-image-tint-color: rgb(0, 0, 0); background-repeat: no-repeat no-repeat; width: 256px; height: 256px; position: absolute; justify-content: center;"/>
        <ui:VisualElement name="HeartBackground" style="background-image: resource(&quot;Art/Textures/UI_textures/Heart&quot;); background-size: 248px 245px; -unity-background-image-tint-color: rgba(255, 0, 0, 0.502); background-repeat: no-repeat no-repeat; width: 256px; height: 256px; position: absolute;"/>
        <ui:VisualElement name="HeartRotatedBack" style="flex-grow: 1; flex-direction: column; rotate: 180deg; position: absolute; height: 244px; width: 256px; top: 7px;">
            <ui:VisualElement name="HeartSlider" style="flex-grow: 1; background-image: resource(&quot;Art/Textures/UI_textures/Heart&quot;); background-size: 248px 245px; -unity-background-image-tint-color: rgb(54, 233, 45); background-repeat: no-repeat no-repeat; position: absolute; flex-direction: column; max-height: 0%; min-height: 100%; background-position-x: center; background-position-y: bottom 0; rotate: 180deg; width: 256px;"/>
            <ui:Label text="100" name="txtHP" style="-unity-text-align: middle-center; position: absolute; white-space: nowrap; font-size: 64px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(0, 0, 0); width: 100%; height: 100%; rotate: 180deg; padding-bottom: 32px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
