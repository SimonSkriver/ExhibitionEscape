<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; justify-content: space-between;">
        <ui:VisualElement name="HeartBackground" style="background-image: resource(&quot;Art/UI/Sprites/HUD_Sprites/Heart&quot;); background-size: 248px 245px; -unity-background-image-tint-color: rgb(120, 0, 0); background-repeat: no-repeat no-repeat; width: 256px; height: 256px; position: absolute; align-self: stretch; top: 4px; left: 3px;"/>
        <ui:VisualElement name="HeartRotatedBack" style="flex-grow: 1; flex-direction: column; rotate: 180deg; position: absolute; height: 250px; width: 250px; top: 4px; align-self: stretch; left: 9px;">
            <ui:VisualElement name="HeartSliderTrail" style="flex-grow: 1; background-image: resource(&quot;Art/UI/Sprites/HUD_Sprites/Heart&quot;); background-size: 248px 245px; -unity-background-image-tint-color: rgb(255, 241, 239); background-repeat: no-repeat no-repeat; position: absolute; flex-direction: column; max-height: 0%; min-height: 100%; background-position-x: center; background-position-y: bottom 0; rotate: 180deg; width: 256px; align-self: stretch;"/>
            <ui:VisualElement name="HeartSlider" style="flex-grow: 1; background-image: resource(&quot;Art/UI/Sprites/HUD_Sprites/Heart&quot;); background-size: 248px 245px; -unity-background-image-tint-color: rgb(255, 23, 0); background-repeat: no-repeat no-repeat; position: absolute; flex-direction: column; max-height: 0%; min-height: 100%; background-position-x: center; background-position-y: bottom 0; rotate: 180deg; width: 256px; align-self: stretch;"/>
            <ui:Label text="100" name="txtHP" style="-unity-text-align: middle-center; position: absolute; white-space: nowrap; font-size: 64px; -unity-font-style: bold; color: rgb(233, 62, 45); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(233, 62, 45); width: 100%; height: 100%; rotate: 180deg; padding-bottom: 32px; display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HeartOutline" style="background-image: resource(&quot;Art/UI/Sprites/HUD_Sprites/HeartOutline&quot;); background-size: 256px 256px; -unity-background-image-tint-color: rgb(0, 0, 0); background-repeat: no-repeat no-repeat; width: 260px; height: 260px; position: absolute; justify-content: center; align-self: stretch; display: flex;">
            <ui:VisualElement name="OutlineFix" style="flex-grow: 1; background-color: rgb(0, 0, 0); position: absolute; width: 12px; height: 2px; top: 250px; left: 122px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; display: flex;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
